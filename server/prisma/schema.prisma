generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  name          String
  password      String
  phone         String?
  profilePic    String?
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(STUDENT)
  announcements Announcement[]
  faculty       Faculty?
  passwordReset PasswordReset?
  student       Student?
  
  @@index([email])
  @@index([role])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([email])
  @@index([expiresAt])
}

model Course {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  createdAt     DateTime       @default(now())
  description   String?
  duration      Int
  fees          Float?
  isActive      Boolean        @default(true)
  updatedAt     DateTime       @updatedAt
  feeStructures FeeStructure[]
  students      Student[]
  subjects      Subject[]
  
  @@index([code])
  @@index([isActive])
}

model Subject {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  credits     Int
  semester    Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courseId    String
  facultyId   String?
  attendances Attendance[]
  results     Result[]
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty     Faculty?     @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  
  @@unique([courseId, code])
  @@unique([courseId, semester, name])
  @@index([courseId])
  @@index([facultyId])
  @@index([semester])
  @@index([isActive])
}

model Student {
  id                String             @id @default(cuid())
  userId            String             @unique
  enrollmentNo      String             @unique
  address           String?
  fatherName        String?
  motherName        String?
  courseId          String
  createdAt         DateTime           @default(now())
  currentCGPA       Float?             @default(0.0)
  dob               DateTime?
  isActive          Boolean            @default(true)
  rollNo            String             @unique
  semester          Int                @default(1)
  updatedAt         DateTime           @updatedAt
  attendances       Attendance[]
  feePayments       FeePayment[]
  leaveApplications LeaveApplication[]
  results           Result[]
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([enrollmentNo])
  @@index([rollNo])
  @@index([courseId])
  @@index([semester])
  @@index([isActive])
}

model Faculty {
  id                String             @id @default(cuid())
  userId            String             @unique
  employeeId        String             @unique
  createdAt         DateTime           @default(now())
  department        String?
  isActive          Boolean            @default(true)
  joiningDate       DateTime?
  qualification     String?
  specialization    String?
  updatedAt         DateTime           @updatedAt
  level             FacultyLevel?      @default(PROFESSOR)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveApplications LeaveApplication[]
  subjects          Subject[]
  
  @@index([employeeId])
  @@index([department])
  @@index([isActive])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime         @default(now())
  createdAt DateTime         @default(now())
  remarks   String?
  subjectId String
  updatedAt DateTime         @updatedAt
  status    AttendanceStatus @default(PRESENT)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, subjectId, date])
  @@index([studentId])
  @@index([subjectId])
  @@index([date])
  @@index([status])
}

model Result {
  id            String    @id @default(cuid())
  studentId     String
  marksObtained Float
  totalMarks    Float     @default(100.0)
  grade         String?
  createdAt     DateTime  @default(now())
  examDate      DateTime?
  examType      String?
  publishedAt   DateTime?
  subjectId     String
  updatedAt     DateTime  @updatedAt
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, subjectId, examType])
  @@index([studentId])
  @@index([subjectId])
  @@index([grade])
  @@index([publishedAt])
}

// Add this to your existing schema.prisma file
model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  courseId    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  course      Course?  @relation(fields: [courseId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
  
  @@index([courseId])
  @@index([createdById])
  @@index([dueDate])
}

// Add to schema.prisma
model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  courseId    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  course      Course?  @relation(fields: [courseId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
  
  @@index([courseId])
  @@index([createdById])
  @@index([dueDate])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  isImportant Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  @@index([authorId])
  @@index([category])
  @@index([isImportant])
  @@index([createdAt])
}

model LeaveApplication {
  id        String      @id @default(cuid())
  reason    String
  startDate DateTime
  endDate   DateTime
  comments  String?
  createdAt DateTime    @default(now())
  facultyId String?
  studentId String
  updatedAt DateTime    @updatedAt
  status    LeaveStatus @default(PENDING)
  faculty   Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@index([studentId])
  @@index([facultyId])
  @@index([status])
  @@index([startDate])
}

model FeeStructure {
  id          String       @id @default(cuid())
  name        String
  description String?
  amount      Float
  dueDate     DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courseId    String
  semester    Int?
  payments    FeePayment[]
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([courseId, semester, name])
  @@index([courseId])
  @@index([dueDate])
  @@index([isActive])
}

model FeePayment {
  id               String        @id @default(cuid())
  studentId        String
  paymentDate      DateTime?
  transactionId    String?       @unique
  amountPaid       Float
  createdAt        DateTime      @default(now())
  feeStructureId   String
  paymentMethod    String?
  paymentStatus    PaymentStatus @default(PENDING)
  receiptNumber    String?       @unique
  updatedAt        DateTime      @updatedAt
  razorpayOrderId  String?
  razorpayPaymentId String?
  razorpaySignature String?
  dueDate          DateTime?
  lateFee          Float?        @default(0)
  receiptPath      String?
  feeStructure     FeeStructure  @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@index([studentId])
  @@index([feeStructureId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([receiptNumber])
}

model ChatThread {
  id        String    @id @default(cuid())
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  participants ChatThreadParticipant[]
  
  @@index([updatedAt])
}

model ChatThreadParticipant {
  id        String     @id @default(cuid())
  threadId  String
  userId    String
  joinedAt  DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([threadId, userId])
  @@index([threadId])
  @@index([userId])
}

model Message {
  id        String     @id @default(cuid())
  threadId  String
  content   String
  senderId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum FacultyLevel {
  PROFESSOR
  HOD
  DEAN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HOLIDAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}